# ---- Macro regime (LAYER 1) — set manually, update after each FOMC/CPI ----
# HOSTILE | NEUTRAL | SUPPORTIVE
MACRO_REGIME=HOSTILE

# ---- Bybit endpoints ----
# REST defaults to the bytick mirror (api.bytick.com): the primary api.bybit.com
# is geo-blocked in some regions. The WEBSOCKET defaults to the PRIMARY
# (stream.bybit.com): the mirror's WS went bad — it accepts connections in some
# regions but never delivers data, so the dashboard showed "connected" with zero
# liquidations/whale volume forever. Override either if your host needs it.
# BYBIT_BASE=https://api.bytick.com
# BYBIT_WS=wss://stream.bybit.com/v5/public/linear

# ---- DB snapshot backup (free-tier amnesia fix; optional but recommended) ----
# Create a PRIVATE GitHub repo (e.g. you/signalia-data) + a fine-grained PAT
# with contents read/write on it. The app pushes a gzipped SQLite snapshot
# every BACKUP_EVERY_HOURS and restores it on boot when the local DB is empty,
# so adaptive baselines + scorecard history survive Render free-tier restarts.
# BACKUP_REPO=you/signalia-data
# BACKUP_TOKEN=github_pat_...
# BACKUP_EVERY_HOURS=12

# ---- Telegram two-way bot (optional) ----
# With TELEGRAM_TOKEN + TELEGRAM_CHAT_ID set (same as alerts), the bot answers
# commands too: /status /why /deployed 25 /scan /watch /scorecard. The webhook
# self-registers at boot using RENDER_EXTERNAL_URL (injected by Render); set
# TELEGRAM_WEBHOOK_BASE only on other hosts. Only TELEGRAM_CHAT_ID is answered.
# TELEGRAM_WEBHOOK_BASE=https://your-app.example.com

# ---- Confirmation trigger tuning (optional overrides) ----
# BTC_RECLAIM_LEVEL: leave UNSET to track the 50d SMA automatically (recommended —
# a static level goes stale as the market moves). Set a number to pin it manually.
# BTC_RECLAIM_LEVEL=74000
RUN_INTERVAL_MIN=15
ALERT_DELTA=10

# ---- Dashboard / API auth (REQUIRED on any public deploy) ----
# DASH_PIN: 4-digit PIN — the browser greets you with a digital lock screen;
#   unlocking keeps a signed 30-day session. Wrong tries rate-limited (5/5min).
# DASH_TOKEN: machine door for curl/automation (?key=<token> or X-Auth-Token).
# SECRET_KEY: signs the session cookie — set any long random string on deploys.
# All unset = everything open (fine on localhost).
DASH_PIN=
DASH_TOKEN=
SECRET_KEY=

# ---- Telegram alerts ----
# 1) message @BotFather -> /newbot -> copy the token
# 2) message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email alerts (SMTP) ----
# For Gmail: enable 2FA, create an App Password, use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
EMAIL_TO=you@gmail.com

# ---- State persistence ----
# On Render, attach a persistent disk and point this at it, e.g. /data/state.json
STATE_FILE=state.json

# ============ v2 ============
# Watchlist SEED only — after first boot, add/remove names from the dashboard
# (validated against Bybit, CoinGecko ATH auto-mapped, no restart needed).
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT
# Streams stay env-bound (websocket subscriptions are fixed at boot):
LIQ_SYMBOLS=BTCUSDT,SOLUSDT,ETHUSDT

# Persistence + adaptive baseline (point DB at Render persistent disk)
DB_FILE=/data/ladder.db
BASELINE_DAYS=30

# Market scanner liquidity floor (24h turnover, USD)
SCAN_MIN_TURNOVER=5000000

# Position-aware sizing: set to your dry-powder size for $ tranches
CAPITAL_BASE=0

# Whale flow (free, venue-level; see whales.py)
# WHALE_SYMBOLS=BTCUSDT            # publicTrade is busy — keep this tight
# WHALE_MIN_CLIP_USD=100000        # what counts as a whale clip
# WHALE_RETAIL_MAX_USD=10000       # below this = retail tape (for the divergence read)
# WHALE_NET_ALERT_USD=5000000      # 1h net large-buy delta that alerts during fear

# Scaffolded layers (optional)
FRED_API_KEY=
DERIBIT_ENABLED=0
ETF_FLOW_OVERRIDE=
